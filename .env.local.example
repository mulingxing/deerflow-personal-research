# Copy this file to .env. Keep real API keys in .env only.
DEEPSEEK_API_KEY=

DEBUG=False
APP_ENV=development
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AGENT_RECURSION_LIMIT=30

# Tavily is the original search integration. Fill its key for web research.
# Alternatively use SEARCH_API=duckduckgo (no key, network access required).
SEARCH_API=tavily
TAVILY_API_KEY=
INFOQUEST_API_KEY=
JINA_API_KEY=

# Optional features can be configured when their lessons are reached.
ENABLE_MCP_SERVER_CONFIGURATION=false
ENABLE_PYTHON_REPL=false
LANGGRAPH_CHECKPOINT_SAVER=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
VOLCENGINE_TTS_APPID=
VOLCENGINE_TTS_ACCESS_TOKEN=

# 第一阶段：个人资料研究。Qdrant 将向量索引保存在项目的 .runtime 目录。
# FastEmbed 在本机 CPU 上生成中文向量，首次使用时需要下载模型。
RAG_PROVIDER=qdrant
QDRANT_LOCATION=.runtime/qdrant
QDRANT_COLLECTION=documents
QDRANT_EMBEDDING_PROVIDER=fastembed
QDRANT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
QDRANT_AUTO_LOAD_EXAMPLES=false
RAG_MAX_UPLOAD_MB=50
RAG_MAX_CHUNKS=5000
